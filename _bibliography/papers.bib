@article{xiang2026contactbench,
  title = {{ContactBench 1.0: A Benchmark for Everyday Contact-Rich Robotic Manipulation}},
  author = {Xiang, Jingyi and Wang, Yixuan and Bohg, Jeannette and Yuan, Wenzhen},
  journal = {Preprint},
  year = {2026},
  month = {October},
  abstract = {Contact-rich manipulation underlies many everyday human activities, yet evaluating robots on such tasks remains difficult: the tasks involve diverse contact behaviors and are hard to reproduce across laboratories. Drawing on observations of everyday human manipulation, we identify eight essential skills that provide a practical framework for studying contact-rich manipulation. We introduce ContactBench 1.0, an extensible benchmark that instantiates these skills through 36 reference tasks and more than 40 object assets. The assets capture task-relevant geometry and contact behavior, can be fabricated reproducibly on consumer-grade 3D printers, and are each paired with a matching simulation model. Controlled task variations in both the real world and simulation enable evaluation of how well robot systems generalize. We evaluate recent representative vision-only and visual-tactile policy learning methods on six benchmark tasks. The results reveal that while vision-only policies struggle to perceive or react to contact events, visual-tactile policies do not meaningfully improve their performance, highlighting that contact-rich manipulation remains a significant challenge for current policy learning methods. By providing common task definitions alongside physical and simulated assets, ContactBench 1.0 offers a shared testbed for developing, evaluating, and comparing contact-rich manipulation systems. The benchmark will be open-sourced at https://jingyi-xiang.github.io/contactbench.},
  pdf = {https://jingyi-xiang.github.io/contactbench/website_assets/pdf/contact-rich-manipulation-benchmark.pdf},
  project = {https://jingyi-xiang.github.io/contactbench/},
  preview = {contactbench.png},
  selected={true}
}

@article{xiang2026tactile,
  title = {{Tactile-Based Robotic Manipulation: From Mechanics-Driven to Data-Driven Perspectives}},
  author = {Xiang, Jingyi and Wang, Yixuan and Yuan, Wenzhen},
  journal = {Annual Review of Control, Robotics, and Autonomous Systems},
  abbr = {Annual Reviews},
  year = {2026},
  month = {October},
  doi = {10.1146/annurev-control-032125-030330},
  abstract = {Tactile sensing provides robots with direct access to physical interactions at the contact interface, making it a critical modality for robust and dexterous manipulation. Over the past several decades, tactile-based manipulation research has evolved from mechanics-driven approaches, which explicitly interpret tactile signals through contact mechanics and task-specific reasoning, to data-driven approaches that learn tactile representations and manipulation policies directly from data. This article reviews the development of tactile-based manipulation from these two complementary perspectives. We first introduce the fundamentals of tactile sensing and then review, from a mechanics-driven perspective, how those signals form manipulation-relevant state representations and subsequently influence the robot action. We then examine the recent advances in data-driven tactile manipulation, covering imitation learning, reinforcement learning, vision--language--action models, and predictive models. Finally, we discuss open challenges and future opportunities toward scalable, generalizable, and robust tactile-enabled robotic systems.},
  pdf = {https://www.annualreviews.org/content/journals/10.1146/annurev-control-032125-030330},
  selected={true}
}

@inproceedings{huang2023kitchen,
  year = {2024},
  booktitle = {{IEEE International Conference on Robotics and Automation (ICRA)}},
  title = {Kitchen Artist: Precise Control of Liquid Dispensing for Gourmet Plating},
  month = {May},
  author = {Huang, Hung-Jui and Xiang, Jingyi and Yuan, Wenzhen},
  abstract = {Manipulating liquid is widely required for many tasks, especially in cooking. A common way to address this is extruding viscous liquid from a squeeze bottle. In this work, our goal is to create a sauce plating robot, which requires precise control of the thickness of squeezed liquids on a surface. Different liquids demand different manipulation policies. We command the robot to tilt the container and monitor the liquid response using a force sensor to identify liquid properties. Based on the liquid properties, we predict the liquid behavior with fixed squeezing motions in a data-driven way and calculate the required drawing speed for the desired stroke size. This open-loop system works effectively even without sensor feedback. Our experiments demonstrate accurate stroke size control across different liquids and fill levels. We show that understanding liquid properties can facilitate effective liquid manipulation. More importantly, our dish garnishing robot has a wide range of applications and holds significant commercialization potential.},
  pdf = {https://arxiv.org/pdf/2311.12185.pdf},
  preview = {squeezebot.png},
  video = {https://youtu.be/hZlQyrqnMsI},
  project = {https://robo-touch.github.io/kitchen-artist/},
  selected={true}
}

@article{xiang2023trackdlo,
  title = {{TrackDLO: Tracking Deformable Linear Objects Under Occlusion with Motion Coherence}},
  author = {Xiang, Jingyi and Dinkel, Holly and Zhao, Harry and Gao, Naixiang and Coltin, Brian and Smith, Trey and Bretl, Timothy},
  journal={IEEE Robotics and Automation Letters},
  year = {2023},
  month = {August},
  volume={8},
  number={10},
  pages={6179-6186},
  doi={10.1109/LRA.2023.3303710},
  abstract = {The TrackDLO algorithm estimates the shape of a Deformable Linear Object (DLO) under occlusion from a sequence of RGB-D images. TrackDLO is vision-only and runs in real-time. It requires no external state information from physics modeling, simulation, visual markers, or contact as input. The algorithm improves on previous approaches by addressing three common scenarios which cause tracking failure: tip occlusion, mid-section occlusion, and self-occlusion. This is achieved through the application of Motion Coherence Theory to impute the spatial velocity of occluded nodes, the use of the topological geodesic distance to track self-occluding DLOs, and the introduction of a non-Gaussian kernel that only penalizes lower-order spatial displacement derivatives to reflect DLO physics. Improved real-time DLO tracking under mid-section occlusion, tip occlusion, and self-occlusion is demonstrated experimentally. The source code and demonstration data are publicly released.},
  pdf = {trackdlo.pdf},
  code = {https://github.com/RMDLO/trackdlo},
  preview = {trackdlo_preview.png},
  video = {https://youtu.be/MxqNJsen5eg},
  poster = {trackdlo_poster.pdf},
  selected={true}
}

@inproceedings{dinkel2022RMDLO,
    author = {Dinkel*, Holly and Xiang*, Jingyi and Zhao, Harry and Coltin, Brian and Smith, Trey and Bretl, Timothy},
    year = {2022},
    booktitle={{Workshop on Representing and Manipulating Deformable Objects, IEEE International Conference on Robotics and Automation (ICRA)}},
    title = {{Wire Point Cloud Instance Segmentation from RGBD Imagery with Mask R-CNN}},
    month = {May},
    abstract = {Perception of the shapes of deforming objects like wires enables their monitoring and manipulation by autonomous robots. This paper presents detection, classification, and instance segmentation of deformable wires from a cluttered scene in RGBD imagery. This work uses the Detectron2 implementation of Mask R-CNN trained with the PointRend mask head on the UIUCWires dataset as the framework for wire instance segmentation on RGB imagery, a method demonstrated to perform well for the instance segmentation task in previous work. In this work, the instance bitmask is directly used to segment individual object point clouds, an important step toward wire shape representation for manipulation tasks.},
    pdf = {https://deformable-workshop.github.io/icra2022/spotlight/WDOICRA2022_08.pdf},
    preview = {wire_segmentation.png},
    video = {https://youtu.be/eqgZQckCDOY},
    selected={false}
}

@inproceedings{xiang2023multidlo,
    author = {Xiang, Jingyi and Dinkel, Holly},
    year = {2023},
    booktitle={{Workshop on Representing and Manipulating Deformable Objects, IEEE International Conference on Robotics and Automation (ICRA)}},
    title = {{Simultaneous Shape Tracking of Multiple Deformable Linear Objects with Global-Local Topology Preservation}},
    month = {May},
    abstract = {This work presents an algorithm for tracking the shape of multiple entangling Deformable Linear Objects (DLOs) from a sequence of RGB-D images. This algorithm runs in real-time and improves on previous single-DLO tracking approaches by enabling tracking of multiple objects. This is achieved using Global-Local Topology Preservation (GLTP). This work uses the geodesic distance in GLTP to define the distance between separate objects and the distance between different parts of the same object. Tracking multiple entangling DLOs is demonstrated experimentally. The source code is publicly released. },
    pdf = {https://arxiv.org/pdf/2310.13245.pdf},
    code = {https://github.com/RMDLO/multi-dlo},
    preview = {multidlo.png},
    video = {https://youtu.be/hfiqwMxitqA},
    poster = {multi_dlo_poster.pdf},
    selected={false}
}